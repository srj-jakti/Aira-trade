{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "aira-brain": {
      "source": {
        "repo": null
      },
      "build": {
        "builder": "DOCKERFILE",
        "watchPatterns": [
          "src/workers/**",
          "ml-engine/**",
          "package.json",
          "nixpacks.toml"
        ]
      },
      "deploy": {
        "startCommand": "npm run worker:logic",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      }
    }
  }
}