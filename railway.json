{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
      "trading-engine": {
        "source": {
          "repo": null
        },
        "build": {
          "builder": "DOCKERFILE",
          "watchPatterns": ["railway/trading-engine/**"]
        },
        "deploy": {
          "startCommand": "cd railway/trading-engine && npm install && npm run build && node dist/engine.js",
          "restartPolicyType": "ON_FAILURE",
          "restartPolicyMaxRetries": 10
        }
      },
      "market-data-worker": {
        "source": {
          "repo": null
        },
        "build": {
          "builder": "DOCKERFILE",
          "watchPatterns": ["railway/market-data-worker/**"]
        },
        "deploy": {
          "startCommand": "cd railway/market-data-worker && npm install && npm run build && node dist/worker.js",
          "restartPolicyType": "ON_FAILURE",
          "restartPolicyMaxRetries": 10
        }
      },
      "cron-maintenance": {
        "source": {
          "repo": null
        },
        "build": {
          "builder": "DOCKERFILE",
          "watchPatterns": ["railway/cron-maintenance/**"]
        },
        "deploy": {
          "startCommand": "cd railway/cron-maintenance && npm install && npm run build && node dist/worker.js",
          "restartPolicyType": "ON_FAILURE",
          "restartPolicyMaxRetries": 10
        }
      }
  }
}
