{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "trading-engine": {
      "source": {
        "repo": null
      },
      "build": {
        "builder": "DOCKERFILE",
        "watchPatterns": [
          "railway/trading-engine/**",
          "src/lib/zairoth/**"
        ]
      },
      "deploy": {
        "startCommand": "cd railway/trading-engine && npm install && npm run build && node dist/railway/trading-engine/src/engine.js",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      }
    },
    "aira-brain": {
      "source": {
        "repo": null
      },
      "build": {
        "builder": "NIXPACKS",
        "watchPatterns": [
          "src/workers/**",
          "ml-engine/**",
          "package.json",
          "nixpacks.toml"
        ]
      },
      "deploy": {
        "startCommand": "npm run worker:logic",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      }
    }
  }
}