{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "market-data-worker": {
      "source": {
        "repo": null
      },
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "railway/market-data-worker/Dockerfile"
      },
      "deploy": {
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      }
    },
    "trading-engine": {
      "source": {
        "repo": null
      },
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "railway/trading-engine/Dockerfile"
      },
      "deploy": {
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      }
    },
    "rl-engine": {
      "source": {
        "repo": null
      },
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "railway/rl-engine/Dockerfile"
      },
      "deploy": {
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      }
    }
  }
}
