{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/zerodha-auto-login",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/cron/zerodha-auto-login",
      "schedule": "0 4,6,8,10 * * 1-5"
    },
    {
      "path": "/api/cron/health-check",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/refresh-subscriptions?action=daily_sync",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/refresh-subscriptions?action=atm_refresh",
      "schedule": "*/5 4-10 * * 1-5"
    },
    {
      "path": "/api/cron/database-cleanup",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/option-roll",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/aggregate-instruments",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/execute-signals",
      "schedule": "* 4-10 * * 1-5"
    }
  ]
}
