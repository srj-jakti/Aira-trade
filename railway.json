{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "trading-engine": {
      "root": "railway/trading-engine",
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "Dockerfile"
      }
    },
    "market-data-worker": {
      "root": "railway/market-data-worker",
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "Dockerfile"
      }
    },
    "rl-engine": {
      "root": "railway/rl-engine",
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "Dockerfile"
      },
      "deploy": {
        "startCommand": "python main.py",
        "restartPolicyType": "ON_FAILURE",
        "numReplicas": 1
      }
    }
  }
}
