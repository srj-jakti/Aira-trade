# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres.[PROJECT-ID]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres

# Encryption (32 bytes = 64 hex chars)
ENCRYPTION_KEY=your-64-hex-char-key

# Redis
REDIS_URL=redis://default:password@host:port

# Security
CRON_SECRET=your-random-secret-for-cron-jobs
ADMIN_SECRET=your-random-secret-for-admin-access
