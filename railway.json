{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "market-data-worker": {
      "source": {
        "repo": null
      },
      "build": {
        "builder": "NIXPACKS",
        "watchPatterns": [
          "railway/market-data-worker/**"
        ]
      },
      "deploy": {
        "startCommand": "cd railway/market-data-worker && npm start",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      }
    },
    "trading-engine": {
      "source": {
        "repo": null
      },
      "build": {
        "builder": "NIXPACKS",
        "watchPatterns": [
          "railway/trading-engine/**"
        ]
      },
      "deploy": {
        "startCommand": "cd railway/trading-engine && npm start",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      }
    }
  }
}